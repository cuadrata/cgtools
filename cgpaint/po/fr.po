#: cgpaint/cgpaint.c:42
msgid "Free-Form Select"
msgstr "Sélection libre"

#: cgpaint/cgpaint.c:42
msgid "Selects a part of the picture of any shape, to move, copy or change."
msgstr ""
"Sélectionne une partie de l'image de forme quelconque, pour la déplacer, la "
"copier ou la modifier."

#: cgpaint/cgpaint.c:43
msgid "Select"
msgstr "Sélection"

#: cgpaint/cgpaint.c:43
msgid "Selects a rectangle of the picture, to move, copy or change."
msgstr ""
"Sélectionne un rectangle de l'image, pour le déplacer, le copier ou le "
"modifier."

#: cgpaint/cgpaint.c:44
msgid "Eraser"
msgstr "Gomme"

#: cgpaint/cgpaint.c:44
msgid ""
"Rubs out with the background color; with the right button, only the "
"foreground color."
msgstr ""
"Efface avec la couleur d'arrière-plan ; avec le bouton droit, seulement la "
"couleur de premier plan."

#: cgpaint/cgpaint.c:45
msgid "Fill With Color"
msgstr "Remplissage"

#: cgpaint/cgpaint.c:45
msgid "Fills an area of one color with another."
msgstr "Remplit une zone d'une couleur avec une autre."

#: cgpaint/cgpaint.c:46
msgid "Pick Color"
msgstr "Prélèvement d'une couleur"

#: cgpaint/cgpaint.c:46
msgid "Takes a color from the picture to draw with."
msgstr "Prélève une couleur dans l'image pour dessiner avec."

#: cgpaint/cgpaint.c:47
msgid "Magnifier"
msgstr "Loupe"

#: cgpaint/cgpaint.c:47
msgid "Shows the picture larger, or at its own size again."
msgstr "Affiche l'image en plus grand, ou de nouveau à sa taille."

#: cgpaint/cgpaint.c:48
msgid "Pencil"
msgstr "Crayon"

#: cgpaint/cgpaint.c:48
msgid "Draws a line one point wide where the pointer goes."
msgstr "Trace une ligne d'un point de large là où passe le pointeur."

#: cgpaint/cgpaint.c:49
msgid "Brush"
msgstr "Pinceau"

#: cgpaint/cgpaint.c:49
msgid "Draws with a brush of the shape and size chosen."
msgstr "Dessine avec un pinceau de la forme et de la taille choisies."

#: cgpaint/cgpaint.c:50
msgid "Airbrush"
msgstr "Aérographe"

#: cgpaint/cgpaint.c:50
msgid "Sprays color, as widely as chosen."
msgstr "Pulvérise de la couleur, sur la largeur choisie."

#: cgpaint/cgpaint.c:51
msgid "Text"
msgstr "Texte"

#: cgpaint/cgpaint.c:51
msgid "Types text into the picture."
msgstr "Saisit du texte dans l'image."

#: cgpaint/cgpaint.c:52
msgid "Line"
msgstr "Ligne"

#: cgpaint/cgpaint.c:52
msgid "Draws a straight line of the width chosen."
msgstr "Trace une ligne droite de l'épaisseur choisie."

#: cgpaint/cgpaint.c:53
msgid "Curve"
msgstr "Courbe"

#: cgpaint/cgpaint.c:53
msgid "Draws a line of the width chosen, and then bends it, once or twice."
msgstr ""
"Trace une ligne de l'épaisseur choisie, puis la courbe, une ou deux fois."

#: cgpaint/cgpaint.c:54
msgid "Rectangle"
msgstr "Rectangle"

#: cgpaint/cgpaint.c:54
msgid "Draws a rectangle, filled as chosen."
msgstr "Dessine un rectangle, rempli comme choisi."

#: cgpaint/cgpaint.c:55
msgid "Polygon"
msgstr "Polygone"

#: cgpaint/cgpaint.c:55
msgid "Draws a shape of straight sides, filled as chosen."
msgstr "Dessine une forme à côtés droits, remplie comme choisi."

#: cgpaint/cgpaint.c:56
msgid "Ellipse"
msgstr "Ellipse"

#: cgpaint/cgpaint.c:56
msgid "Draws an ellipse, filled as chosen."
msgstr "Dessine une ellipse, remplie comme choisi."

#: cgpaint/cgpaint.c:57
msgid "Rounded Rectangle"
msgstr "Rectangle arrondi"

#: cgpaint/cgpaint.c:57
msgid "Draws a rectangle with round corners, filled as chosen."
msgstr "Dessine un rectangle aux coins arrondis, rempli comme choisi."

