#: cgpaint/cgpaint.c:42
msgid "Free-Form Select"
msgstr "Выделение произвольной области"

#: cgpaint/cgpaint.c:42
msgid "Selects a part of the picture of any shape, to move, copy or change."
msgstr ""
"Выделяет часть рисунка любой формы, чтобы переместить, скопировать или "
"изменить её."

#: cgpaint/cgpaint.c:43
msgid "Select"
msgstr "Выделение"

#: cgpaint/cgpaint.c:43
msgid "Selects a rectangle of the picture, to move, copy or change."
msgstr ""
"Выделяет прямоугольник рисунка, чтобы переместить, скопировать или изменить "
"его."

#: cgpaint/cgpaint.c:44
msgid "Eraser"
msgstr "Ластик"

#: cgpaint/cgpaint.c:44
msgid ""
"Rubs out with the background color; with the right button, only the "
"foreground color."
msgstr "Стирает цветом фона; правой кнопкой — только основной цвет."

#: cgpaint/cgpaint.c:45
msgid "Fill With Color"
msgstr "Заливка"

#: cgpaint/cgpaint.c:45
msgid "Fills an area of one color with another."
msgstr "Заливает область одного цвета другим."

#: cgpaint/cgpaint.c:46
msgid "Pick Color"
msgstr "Выбор цвета"

#: cgpaint/cgpaint.c:46
msgid "Takes a color from the picture to draw with."
msgstr "Берёт цвет с рисунка, чтобы рисовать им."

#: cgpaint/cgpaint.c:47
msgid "Magnifier"
msgstr "Лупа"

#: cgpaint/cgpaint.c:47
msgid "Shows the picture larger, or at its own size again."
msgstr "Показывает рисунок крупнее или снова в его размере."

#: cgpaint/cgpaint.c:48
msgid "Pencil"
msgstr "Карандаш"

#: cgpaint/cgpaint.c:48
msgid "Draws a line one point wide where the pointer goes."
msgstr "Рисует линию шириной в одну точку там, где проходит указатель."

#: cgpaint/cgpaint.c:49
msgid "Brush"
msgstr "Кисть"

#: cgpaint/cgpaint.c:49
msgid "Draws with a brush of the shape and size chosen."
msgstr "Рисует кистью выбранной формы и размера."

#: cgpaint/cgpaint.c:50
msgid "Airbrush"
msgstr "Распылитель"

#: cgpaint/cgpaint.c:50
msgid "Sprays color, as widely as chosen."
msgstr "Распыляет цвет с выбранной шириной."

#: cgpaint/cgpaint.c:51
msgid "Text"
msgstr "Надпись"

#: cgpaint/cgpaint.c:51
msgid "Types text into the picture."
msgstr "Вводит текст в рисунок."

#: cgpaint/cgpaint.c:52
msgid "Line"
msgstr "Линия"

#: cgpaint/cgpaint.c:52
msgid "Draws a straight line of the width chosen."
msgstr "Рисует прямую линию выбранной ширины."

#: cgpaint/cgpaint.c:53
msgid "Curve"
msgstr "Кривая"

#: cgpaint/cgpaint.c:53
msgid "Draws a line of the width chosen, and then bends it, once or twice."
msgstr "Рисует линию выбранной ширины, а затем изгибает её, один или два раза."

#: cgpaint/cgpaint.c:54
msgid "Rectangle"
msgstr "Прямоугольник"

#: cgpaint/cgpaint.c:54
msgid "Draws a rectangle, filled as chosen."
msgstr "Рисует прямоугольник с выбранной заливкой."

#: cgpaint/cgpaint.c:55
msgid "Polygon"
msgstr "Многоугольник"

#: cgpaint/cgpaint.c:55
msgid "Draws a shape of straight sides, filled as chosen."
msgstr "Рисует фигуру с прямыми сторонами и выбранной заливкой."

#: cgpaint/cgpaint.c:56
msgid "Ellipse"
msgstr "Эллипс"

#: cgpaint/cgpaint.c:56
msgid "Draws an ellipse, filled as chosen."
msgstr "Рисует эллипс с выбранной заливкой."

#: cgpaint/cgpaint.c:57
msgid "Rounded Rectangle"
msgstr "Скруглённый прямоугольник"

#: cgpaint/cgpaint.c:57
msgid "Draws a rectangle with round corners, filled as chosen."
msgstr "Рисует прямоугольник со скруглёнными углами и выбранной заливкой."

