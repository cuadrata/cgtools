#: cgpaint/cgpaint.c:42
msgid "Free-Form Select"
msgstr "Selecionar forma livre"

#: cgpaint/cgpaint.c:42
msgid "Selects a part of the picture of any shape, to move, copy or change."
msgstr ""
"Seleciona uma parte da imagem de qualquer forma, para mover, copiar ou "
"alterar."

#: cgpaint/cgpaint.c:43
msgid "Select"
msgstr "Selecionar"

#: cgpaint/cgpaint.c:43
msgid "Selects a rectangle of the picture, to move, copy or change."
msgstr "Seleciona um retângulo da imagem, para mover, copiar ou alterar."

#: cgpaint/cgpaint.c:44
msgid "Eraser"
msgstr "Borracha"

#: cgpaint/cgpaint.c:44
msgid ""
"Rubs out with the background color; with the right button, only the "
"foreground color."
msgstr ""
"Apaga com a cor de fundo; com o botão direito, apenas a cor de primeiro "
"plano."

#: cgpaint/cgpaint.c:45
msgid "Fill With Color"
msgstr "Preencher com cor"

#: cgpaint/cgpaint.c:45
msgid "Fills an area of one color with another."
msgstr "Preenche uma área de uma cor com outra."

#: cgpaint/cgpaint.c:46
msgid "Pick Color"
msgstr "Selecionar cor"

#: cgpaint/cgpaint.c:46
msgid "Takes a color from the picture to draw with."
msgstr "Pega uma cor da imagem para desenhar com ela."

#: cgpaint/cgpaint.c:47
msgid "Magnifier"
msgstr "Lupa"

#: cgpaint/cgpaint.c:47
msgid "Shows the picture larger, or at its own size again."
msgstr "Mostra a imagem maior, ou de novo em seu tamanho."

#: cgpaint/cgpaint.c:48
msgid "Pencil"
msgstr "Lápis"

#: cgpaint/cgpaint.c:48
msgid "Draws a line one point wide where the pointer goes."
msgstr "Desenha uma linha de um ponto de largura por onde o ponteiro passa."

#: cgpaint/cgpaint.c:49
msgid "Brush"
msgstr "Pincel"

#: cgpaint/cgpaint.c:49
msgid "Draws with a brush of the shape and size chosen."
msgstr "Desenha com um pincel da forma e do tamanho escolhidos."

#: cgpaint/cgpaint.c:50
msgid "Airbrush"
msgstr "Spray"

#: cgpaint/cgpaint.c:50
msgid "Sprays color, as widely as chosen."
msgstr "Borrifa cor, na largura escolhida."

#: cgpaint/cgpaint.c:51
msgid "Text"
msgstr "Texto"

#: cgpaint/cgpaint.c:51
msgid "Types text into the picture."
msgstr "Digita texto na imagem."

#: cgpaint/cgpaint.c:52
msgid "Line"
msgstr "Linha"

#: cgpaint/cgpaint.c:52
msgid "Draws a straight line of the width chosen."
msgstr "Desenha uma linha reta da largura escolhida."

#: cgpaint/cgpaint.c:53
msgid "Curve"
msgstr "Curva"

#: cgpaint/cgpaint.c:53
msgid "Draws a line of the width chosen, and then bends it, once or twice."
msgstr ""
"Desenha uma linha da largura escolhida e depois a curva, uma ou duas vezes."

#: cgpaint/cgpaint.c:54
msgid "Rectangle"
msgstr "Retângulo"

#: cgpaint/cgpaint.c:54
msgid "Draws a rectangle, filled as chosen."
msgstr "Desenha um retângulo, preenchido como escolhido."

#: cgpaint/cgpaint.c:55
msgid "Polygon"
msgstr "Polígono"

#: cgpaint/cgpaint.c:55
msgid "Draws a shape of straight sides, filled as chosen."
msgstr "Desenha uma forma de lados retos, preenchida como escolhido."

#: cgpaint/cgpaint.c:56
msgid "Ellipse"
msgstr "Elipse"

#: cgpaint/cgpaint.c:56
msgid "Draws an ellipse, filled as chosen."
msgstr "Desenha uma elipse, preenchida como escolhido."

#: cgpaint/cgpaint.c:57
msgid "Rounded Rectangle"
msgstr "Retângulo arredondado"

#: cgpaint/cgpaint.c:57
msgid "Draws a rectangle with round corners, filled as chosen."
msgstr ""
"Desenha um retângulo com cantos arredondados, preenchido como escolhido."

