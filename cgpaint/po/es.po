#: cgpaint/cgpaint.c:42
msgid "Free-Form Select"
msgstr "Selección de forma libre"

#: cgpaint/cgpaint.c:42
msgid "Selects a part of the picture of any shape, to move, copy or change."
msgstr ""
"Selecciona una parte de la imagen de cualquier forma, para moverla, copiarla "
"o cambiarla."

#: cgpaint/cgpaint.c:43
msgid "Select"
msgstr "Selección"

#: cgpaint/cgpaint.c:43
msgid "Selects a rectangle of the picture, to move, copy or change."
msgstr ""
"Selecciona un rectángulo de la imagen, para moverlo, copiarlo o cambiarlo."

#: cgpaint/cgpaint.c:44
msgid "Eraser"
msgstr "Borrador"

#: cgpaint/cgpaint.c:44
msgid ""
"Rubs out with the background color; with the right button, only the "
"foreground color."
msgstr ""
"Borra con el color de fondo; con el botón derecho, solo el color de primer "
"plano."

#: cgpaint/cgpaint.c:45
msgid "Fill With Color"
msgstr "Relleno con color"

#: cgpaint/cgpaint.c:45
msgid "Fills an area of one color with another."
msgstr "Rellena un área de un color con otro."

#: cgpaint/cgpaint.c:46
msgid "Pick Color"
msgstr "Seleccionar color"

#: cgpaint/cgpaint.c:46
msgid "Takes a color from the picture to draw with."
msgstr "Toma un color de la imagen para dibujar con él."

#: cgpaint/cgpaint.c:47
msgid "Magnifier"
msgstr "Lupa"

#: cgpaint/cgpaint.c:47
msgid "Shows the picture larger, or at its own size again."
msgstr "Muestra la imagen más grande, o de nuevo a su tamaño."

#: cgpaint/cgpaint.c:48
msgid "Pencil"
msgstr "Lápiz"

#: cgpaint/cgpaint.c:48
msgid "Draws a line one point wide where the pointer goes."
msgstr "Dibuja una línea de un punto de ancho por donde pasa el puntero."

#: cgpaint/cgpaint.c:49
msgid "Brush"
msgstr "Pincel"

#: cgpaint/cgpaint.c:49
msgid "Draws with a brush of the shape and size chosen."
msgstr "Dibuja con un pincel de la forma y el tamaño elegidos."

#: cgpaint/cgpaint.c:50
msgid "Airbrush"
msgstr "Aerógrafo"

#: cgpaint/cgpaint.c:50
msgid "Sprays color, as widely as chosen."
msgstr "Rocía color, con la amplitud elegida."

#: cgpaint/cgpaint.c:51
msgid "Text"
msgstr "Texto"

#: cgpaint/cgpaint.c:51
msgid "Types text into the picture."
msgstr "Escribe texto en la imagen."

#: cgpaint/cgpaint.c:52
msgid "Line"
msgstr "Línea"

#: cgpaint/cgpaint.c:52
msgid "Draws a straight line of the width chosen."
msgstr "Dibuja una línea recta del ancho elegido."

#: cgpaint/cgpaint.c:53
msgid "Curve"
msgstr "Curva"

#: cgpaint/cgpaint.c:53
msgid "Draws a line of the width chosen, and then bends it, once or twice."
msgstr "Dibuja una línea del ancho elegido y luego la curva, una o dos veces."

#: cgpaint/cgpaint.c:54
msgid "Rectangle"
msgstr "Rectángulo"

#: cgpaint/cgpaint.c:54
msgid "Draws a rectangle, filled as chosen."
msgstr "Dibuja un rectángulo, con el relleno elegido."

#: cgpaint/cgpaint.c:55
msgid "Polygon"
msgstr "Polígono"

#: cgpaint/cgpaint.c:55
msgid "Draws a shape of straight sides, filled as chosen."
msgstr "Dibuja una figura de lados rectos, con el relleno elegido."

#: cgpaint/cgpaint.c:56
msgid "Ellipse"
msgstr "Elipse"

#: cgpaint/cgpaint.c:56
msgid "Draws an ellipse, filled as chosen."
msgstr "Dibuja una elipse, con el relleno elegido."

#: cgpaint/cgpaint.c:57
msgid "Rounded Rectangle"
msgstr "Rectángulo redondeado"

#: cgpaint/cgpaint.c:57
msgid "Draws a rectangle with round corners, filled as chosen."
msgstr "Dibuja un rectángulo con esquinas redondeadas, con el relleno elegido."

