#: cgpaint/cgpaint.c:42
msgid "Free-Form Select"
msgstr "Freihandauswahl"

#: cgpaint/cgpaint.c:42
msgid "Selects a part of the picture of any shape, to move, copy or change."
msgstr ""
"Wählt einen beliebig geformten Teil des Bildes aus, um ihn zu verschieben, "
"zu kopieren oder zu ändern."

#: cgpaint/cgpaint.c:43
msgid "Select"
msgstr "Auswahl"

#: cgpaint/cgpaint.c:43
msgid "Selects a rectangle of the picture, to move, copy or change."
msgstr ""
"Wählt ein Rechteck des Bildes aus, um es zu verschieben, zu kopieren oder zu "
"ändern."

#: cgpaint/cgpaint.c:44
msgid "Eraser"
msgstr "Radierer"

#: cgpaint/cgpaint.c:44
msgid ""
"Rubs out with the background color; with the right button, only the "
"foreground color."
msgstr ""
"Radiert mit der Hintergrundfarbe; mit der rechten Taste nur die "
"Vordergrundfarbe."

#: cgpaint/cgpaint.c:45
msgid "Fill With Color"
msgstr "Farbfüller"

#: cgpaint/cgpaint.c:45
msgid "Fills an area of one color with another."
msgstr "Füllt einen Bereich einer Farbe mit einer anderen."

#: cgpaint/cgpaint.c:46
msgid "Pick Color"
msgstr "Farbe auswählen"

#: cgpaint/cgpaint.c:46
msgid "Takes a color from the picture to draw with."
msgstr "Nimmt eine Farbe aus dem Bild auf, um damit zu zeichnen."

#: cgpaint/cgpaint.c:47
msgid "Magnifier"
msgstr "Lupe"

#: cgpaint/cgpaint.c:47
msgid "Shows the picture larger, or at its own size again."
msgstr "Zeigt das Bild größer oder wieder in seiner eigenen Größe."

#: cgpaint/cgpaint.c:48
msgid "Pencil"
msgstr "Stift"

#: cgpaint/cgpaint.c:48
msgid "Draws a line one point wide where the pointer goes."
msgstr "Zeichnet eine einen Punkt breite Linie, wo der Zeiger entlangfährt."

#: cgpaint/cgpaint.c:49
msgid "Brush"
msgstr "Pinsel"

#: cgpaint/cgpaint.c:49
msgid "Draws with a brush of the shape and size chosen."
msgstr "Zeichnet mit einem Pinsel der gewählten Form und Größe."

#: cgpaint/cgpaint.c:50
msgid "Airbrush"
msgstr "Sprühdose"

#: cgpaint/cgpaint.c:50
msgid "Sprays color, as widely as chosen."
msgstr "Sprüht Farbe, so breit wie gewählt."

#: cgpaint/cgpaint.c:51
msgid "Text"
msgstr "Text"

#: cgpaint/cgpaint.c:51
msgid "Types text into the picture."
msgstr "Schreibt Text in das Bild."

#: cgpaint/cgpaint.c:52
msgid "Line"
msgstr "Linie"

#: cgpaint/cgpaint.c:52
msgid "Draws a straight line of the width chosen."
msgstr "Zeichnet eine gerade Linie der gewählten Breite."

#: cgpaint/cgpaint.c:53
msgid "Curve"
msgstr "Kurve"

#: cgpaint/cgpaint.c:53
msgid "Draws a line of the width chosen, and then bends it, once or twice."
msgstr ""
"Zeichnet eine Linie der gewählten Breite und biegt sie dann ein- oder "
"zweimal."

#: cgpaint/cgpaint.c:54
msgid "Rectangle"
msgstr "Rechteck"

#: cgpaint/cgpaint.c:54
msgid "Draws a rectangle, filled as chosen."
msgstr "Zeichnet ein Rechteck, gefüllt wie gewählt."

#: cgpaint/cgpaint.c:55
msgid "Polygon"
msgstr "Vieleck"

#: cgpaint/cgpaint.c:55
msgid "Draws a shape of straight sides, filled as chosen."
msgstr "Zeichnet eine Form mit geraden Seiten, gefüllt wie gewählt."

#: cgpaint/cgpaint.c:56
msgid "Ellipse"
msgstr "Ellipse"

#: cgpaint/cgpaint.c:56
msgid "Draws an ellipse, filled as chosen."
msgstr "Zeichnet eine Ellipse, gefüllt wie gewählt."

#: cgpaint/cgpaint.c:57
msgid "Rounded Rectangle"
msgstr "Abgerundetes Rechteck"

#: cgpaint/cgpaint.c:57
msgid "Draws a rectangle with round corners, filled as chosen."
msgstr "Zeichnet ein Rechteck mit runden Ecken, gefüllt wie gewählt."

