#: cgrun/cgrun.c:499
msgid "Programs"
msgstr "Programma's"

#: cgrun/cgrun.c:578 cgrun/cgrun.c:631
msgid "Run"
msgstr "Uitvoeren"

#: cgrun/cgrun.c:590
msgid "Type the name of a program, or a command line."
msgstr "Typ de naam van een programma of een opdrachtregel."

#: cgrun/cgrun.c:598
msgid "Command:"
msgstr "Opdracht:"

#: cgrun/cgrun.c:617
msgid "Run in a terminal"
msgstr "In een terminal uitvoeren"

#: cgrun/cgrun.c:632
msgid "Close"
msgstr "Sluiten"

#: cgrun/cgrun.c:656
#, c-format
msgid "Usage: %s [OPTION...]\n"
msgstr "Gebruik: %s [OPTIE...]\n"

#: cgrun/cgrun.c:658
#, c-format
msgid "  --list       show the list of programs from the start\n"
msgstr "  --list       de lijst met programma's vanaf het begin tonen\n"

#: cgrun/cgrun.c:659
#, c-format
msgid "  --help       show this help and exit\n"
msgstr "  --help       deze hulp tonen en afsluiten\n"

#: cgrun/cgrun.c:660
#, c-format
msgid "  --version    show the version and exit\n"
msgstr "  --version    de versie tonen en afsluiten\n"

#: cgrun/cgrun.c:662
#, c-format
msgid "The usual GTK options, such as --display, are also understood.\n"
msgstr "De gebruikelijke GTK-opties, zoals --display, worden ook begrepen.\n"
