#: cgrun/cgrun.c:499
msgid "Programs"
msgstr "Programos"

#: cgrun/cgrun.c:578 cgrun/cgrun.c:631
msgid "Run"
msgstr "Paleisti"

#: cgrun/cgrun.c:590
msgid "Type the name of a program, or a command line."
msgstr "Įveskite programos pavadinimą arba komandų eilutę."

#: cgrun/cgrun.c:598
msgid "Command:"
msgstr "Komanda:"

#: cgrun/cgrun.c:617
msgid "Run in a terminal"
msgstr "Vykdyti terminale"

#: cgrun/cgrun.c:632
msgid "Close"
msgstr "Užverti"

#: cgrun/cgrun.c:656
#, c-format
msgid "Usage: %s [OPTION...]\n"
msgstr "Naudojimas: %s [PARINKTIS...]\n"

#: cgrun/cgrun.c:658
#, c-format
msgid "  --list       show the list of programs from the start\n"
msgstr "  --list       iš karto rodyti programų sąrašą\n"

#: cgrun/cgrun.c:659
#, c-format
msgid "  --help       show this help and exit\n"
msgstr "  --help       parodyti šią pagalbą ir išeiti\n"

#: cgrun/cgrun.c:660
#, c-format
msgid "  --version    show the version and exit\n"
msgstr "  --version    parodyti versiją ir išeiti\n"

#: cgrun/cgrun.c:662
#, c-format
msgid "The usual GTK options, such as --display, are also understood.\n"
msgstr "Suprantamos ir įprastos GTK parinktys, pavyzdžiui, --display.\n"
