#: cgrun/cgrun.c:499
msgid "Programs"
msgstr "Programmes"

#: cgrun/cgrun.c:578 cgrun/cgrun.c:631
msgid "Run"
msgstr "Exécuter"

#: cgrun/cgrun.c:590
msgid "Type the name of a program, or a command line."
msgstr "Saisissez le nom d'un programme ou une ligne de commande."

#: cgrun/cgrun.c:598
msgid "Command:"
msgstr "Commande :"

#: cgrun/cgrun.c:617
msgid "Run in a terminal"
msgstr "Exécuter dans un terminal"

#: cgrun/cgrun.c:632
msgid "Close"
msgstr "Fermer"

#: cgrun/cgrun.c:656
#, c-format
msgid "Usage: %s [OPTION...]\n"
msgstr "Utilisation : %s [OPTION...]\n"

#: cgrun/cgrun.c:658
#, c-format
msgid "  --list       show the list of programs from the start\n"
msgstr "  --list       afficher la liste des programmes dès le départ\n"

#: cgrun/cgrun.c:659
#, c-format
msgid "  --help       show this help and exit\n"
msgstr "  --help       afficher cette aide et quitter\n"

#: cgrun/cgrun.c:660
#, c-format
msgid "  --version    show the version and exit\n"
msgstr "  --version    afficher la version et quitter\n"

#: cgrun/cgrun.c:662
#, c-format
msgid "The usual GTK options, such as --display, are also understood.\n"
msgstr ""
"Les options habituelles de GTK, comme --display, sont aussi comprises.\n"
