#: cgrun/cgrun.c:499
msgid "Programs"
msgstr "Programme"

#: cgrun/cgrun.c:578 cgrun/cgrun.c:631
msgid "Run"
msgstr "Ausführen"

#: cgrun/cgrun.c:590
msgid "Type the name of a program, or a command line."
msgstr "Geben Sie den Namen eines Programms oder eine Befehlszeile ein."

#: cgrun/cgrun.c:598
msgid "Command:"
msgstr "Befehl:"

#: cgrun/cgrun.c:617
msgid "Run in a terminal"
msgstr "In einem Terminal ausführen"

#: cgrun/cgrun.c:632
msgid "Close"
msgstr "Schließen"

#: cgrun/cgrun.c:656
#, c-format
msgid "Usage: %s [OPTION...]\n"
msgstr "Aufruf: %s [OPTION...]\n"

#: cgrun/cgrun.c:658
#, c-format
msgid "  --list       show the list of programs from the start\n"
msgstr "  --list       die Programmliste von Anfang an anzeigen\n"

#: cgrun/cgrun.c:659
#, c-format
msgid "  --help       show this help and exit\n"
msgstr "  --help       diese Hilfe anzeigen und beenden\n"

#: cgrun/cgrun.c:660
#, c-format
msgid "  --version    show the version and exit\n"
msgstr "  --version    die Version anzeigen und beenden\n"

#: cgrun/cgrun.c:662
#, c-format
msgid "The usual GTK options, such as --display, are also understood.\n"
msgstr "Die üblichen GTK-Optionen wie --display werden ebenfalls verstanden.\n"
