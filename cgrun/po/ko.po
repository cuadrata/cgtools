#: cgrun/cgrun.c:499
msgid "Programs"
msgstr "프로그램"

#: cgrun/cgrun.c:578 cgrun/cgrun.c:631
msgid "Run"
msgstr "실행"

#: cgrun/cgrun.c:590
msgid "Type the name of a program, or a command line."
msgstr "프로그램 이름이나 명령행을 입력하십시오."

#: cgrun/cgrun.c:598
msgid "Command:"
msgstr "명령:"

#: cgrun/cgrun.c:617
msgid "Run in a terminal"
msgstr "터미널에서 실행"

#: cgrun/cgrun.c:632
msgid "Close"
msgstr "닫기"

#: cgrun/cgrun.c:656
#, c-format
msgid "Usage: %s [OPTION...]\n"
msgstr "사용법: %s [옵션...]\n"

#: cgrun/cgrun.c:658
#, c-format
msgid "  --list       show the list of programs from the start\n"
msgstr "  --list       처음부터 프로그램 목록을 보여 줍니다\n"

#: cgrun/cgrun.c:659
#, c-format
msgid "  --help       show this help and exit\n"
msgstr "  --help       이 도움말을 보여주고 끝냅니다\n"

#: cgrun/cgrun.c:660
#, c-format
msgid "  --version    show the version and exit\n"
msgstr "  --version    버전을 보여주고 끝냅니다\n"

#: cgrun/cgrun.c:662
#, c-format
msgid "The usual GTK options, such as --display, are also understood.\n"
msgstr "--display 같은 일반적인 GTK 옵션도 사용할 수 있습니다.\n"
