#: cgrun/cgrun.c:499
msgid "Programs"
msgstr "Programas"

#: cgrun/cgrun.c:578 cgrun/cgrun.c:631
msgid "Run"
msgstr "Executar"

#: cgrun/cgrun.c:590
msgid "Type the name of a program, or a command line."
msgstr "Escriba o nome dun programa ou unha liña de ordes."

#: cgrun/cgrun.c:598
msgid "Command:"
msgstr "Orde:"

#: cgrun/cgrun.c:617
msgid "Run in a terminal"
msgstr "Executar nun terminal"

#: cgrun/cgrun.c:632
msgid "Close"
msgstr "Pechar"

#: cgrun/cgrun.c:656
#, c-format
msgid "Usage: %s [OPTION...]\n"
msgstr "Uso: %s [OPCIÓN...]\n"

#: cgrun/cgrun.c:658
#, c-format
msgid "  --list       show the list of programs from the start\n"
msgstr "  --list       mostrar a lista de programas desde o principio\n"

#: cgrun/cgrun.c:659
#, c-format
msgid "  --help       show this help and exit\n"
msgstr "  --help       mostra esta axuda e sae\n"

#: cgrun/cgrun.c:660
#, c-format
msgid "  --version    show the version and exit\n"
msgstr "  --version    mostra a versión e sae\n"

#: cgrun/cgrun.c:662
#, c-format
msgid "The usual GTK options, such as --display, are also understood.\n"
msgstr "Tamén se entenden as opcións habituais de GTK, como --display.\n"
