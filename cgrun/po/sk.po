#: cgrun/cgrun.c:499
msgid "Programs"
msgstr "Programy"

#: cgrun/cgrun.c:578 cgrun/cgrun.c:631
msgid "Run"
msgstr "Spustiť"

#: cgrun/cgrun.c:590
msgid "Type the name of a program, or a command line."
msgstr "Zadajte názov programu alebo príkazový riadok."

#: cgrun/cgrun.c:598
msgid "Command:"
msgstr "Príkaz:"

#: cgrun/cgrun.c:617
msgid "Run in a terminal"
msgstr "Spustiť v termináli"

#: cgrun/cgrun.c:632
msgid "Close"
msgstr "Zavrieť"

#: cgrun/cgrun.c:656
#, c-format
msgid "Usage: %s [OPTION...]\n"
msgstr "Použitie: %s [PREPÍNAČ...]\n"

#: cgrun/cgrun.c:658
#, c-format
msgid "  --list       show the list of programs from the start\n"
msgstr "  --list       zobraziť zoznam programov od začiatku\n"

#: cgrun/cgrun.c:659
#, c-format
msgid "  --help       show this help and exit\n"
msgstr "  --help       zobrazí tohto pomocníka a skončí\n"

#: cgrun/cgrun.c:660
#, c-format
msgid "  --version    show the version and exit\n"
msgstr "  --version    zobrazí verziu a skončí\n"

#: cgrun/cgrun.c:662
#, c-format
msgid "The usual GTK options, such as --display, are also understood.\n"
msgstr "Rozumie sa aj bežným prepínačom GTK, ako je --display.\n"
