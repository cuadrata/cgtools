#: cgrun/cgrun.c:499
msgid "Programs"
msgstr "Programmid"

#: cgrun/cgrun.c:578 cgrun/cgrun.c:631
msgid "Run"
msgstr "Käivita"

#: cgrun/cgrun.c:590
msgid "Type the name of a program, or a command line."
msgstr "Sisesta programmi nimi või käsurida."

#: cgrun/cgrun.c:598
msgid "Command:"
msgstr "Käsk:"

#: cgrun/cgrun.c:617
msgid "Run in a terminal"
msgstr "Käivita terminalis"

#: cgrun/cgrun.c:632
msgid "Close"
msgstr "Sulge"

#: cgrun/cgrun.c:656
#, c-format
msgid "Usage: %s [OPTION...]\n"
msgstr "Kasutamine: %s [VÕTI...]\n"

#: cgrun/cgrun.c:658
#, c-format
msgid "  --list       show the list of programs from the start\n"
msgstr "  --list       näita programmide nimekirja kohe alguses\n"

#: cgrun/cgrun.c:659
#, c-format
msgid "  --help       show this help and exit\n"
msgstr "  --help       näita seda abi ja välju\n"

#: cgrun/cgrun.c:660
#, c-format
msgid "  --version    show the version and exit\n"
msgstr "  --version    näita versiooni ja välju\n"

#: cgrun/cgrun.c:662
#, c-format
msgid "The usual GTK options, such as --display, are also understood.\n"
msgstr "Mõistetakse ka tavalisi GTK võtmeid, nagu --display.\n"
