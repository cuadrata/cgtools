#: cgrun/cgrun.c:499
msgid "Programs"
msgstr "プログラム"

#: cgrun/cgrun.c:578 cgrun/cgrun.c:631
msgid "Run"
msgstr "実行"

#: cgrun/cgrun.c:590
msgid "Type the name of a program, or a command line."
msgstr "プログラムの名前またはコマンドラインを入力してください。"

#: cgrun/cgrun.c:598
msgid "Command:"
msgstr "コマンド:"

#: cgrun/cgrun.c:617
msgid "Run in a terminal"
msgstr "端末で実行"

#: cgrun/cgrun.c:632
msgid "Close"
msgstr "閉じる"

#: cgrun/cgrun.c:656
#, c-format
msgid "Usage: %s [OPTION...]\n"
msgstr "使い方: %s [オプション...]\n"

#: cgrun/cgrun.c:658
#, c-format
msgid "  --list       show the list of programs from the start\n"
msgstr "  --list       最初からプログラムの一覧を表示する\n"

#: cgrun/cgrun.c:659
#, c-format
msgid "  --help       show this help and exit\n"
msgstr "  --help       このヘルプを表示して終了する\n"

#: cgrun/cgrun.c:660
#, c-format
msgid "  --version    show the version and exit\n"
msgstr "  --version    バージョンを表示して終了する\n"

#: cgrun/cgrun.c:662
#, c-format
msgid "The usual GTK options, such as --display, are also understood.\n"
msgstr "--display など、GTK の通常のオプションも使えます。\n"
