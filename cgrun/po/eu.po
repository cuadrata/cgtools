#: cgrun/cgrun.c:499
msgid "Programs"
msgstr "Programak"

#: cgrun/cgrun.c:578 cgrun/cgrun.c:631
msgid "Run"
msgstr "Exekutatu"

#: cgrun/cgrun.c:590
msgid "Type the name of a program, or a command line."
msgstr "Idatzi programa baten izena edo komando-lerro bat."

#: cgrun/cgrun.c:598
msgid "Command:"
msgstr "Komandoa:"

#: cgrun/cgrun.c:617
msgid "Run in a terminal"
msgstr "Exekutatu terminalean"

#: cgrun/cgrun.c:632
msgid "Close"
msgstr "Itxi"

#: cgrun/cgrun.c:656
#, c-format
msgid "Usage: %s [OPTION...]\n"
msgstr "Erabilera: %s [AUKERA...]\n"

#: cgrun/cgrun.c:658
#, c-format
msgid "  --list       show the list of programs from the start\n"
msgstr "  --list       erakutsi programen zerrenda hasieratik\n"

#: cgrun/cgrun.c:659
#, c-format
msgid "  --help       show this help and exit\n"
msgstr "  --help       laguntza hau erakutsi eta irten\n"

#: cgrun/cgrun.c:660
#, c-format
msgid "  --version    show the version and exit\n"
msgstr "  --version    bertsioa erakutsi eta irten\n"

#: cgrun/cgrun.c:662
#, c-format
msgid "The usual GTK options, such as --display, are also understood.\n"
msgstr "GTKren ohiko aukerak ere ulertzen dira, --display adibidez.\n"
