#: cgrun/cgrun.c:499
msgid "Programs"
msgstr "Ohjelmat"

#: cgrun/cgrun.c:578 cgrun/cgrun.c:631
msgid "Run"
msgstr "Suorita"

#: cgrun/cgrun.c:590
msgid "Type the name of a program, or a command line."
msgstr "Kirjoita ohjelman nimi tai komentorivi."

#: cgrun/cgrun.c:598
msgid "Command:"
msgstr "Komento:"

#: cgrun/cgrun.c:617
msgid "Run in a terminal"
msgstr "Suorita päätteessä"

#: cgrun/cgrun.c:632
msgid "Close"
msgstr "Sulje"

#: cgrun/cgrun.c:656
#, c-format
msgid "Usage: %s [OPTION...]\n"
msgstr "Käyttö: %s [VALITSIN...]\n"

#: cgrun/cgrun.c:658
#, c-format
msgid "  --list       show the list of programs from the start\n"
msgstr "  --list       näytä ohjelmaluettelo heti alussa\n"

#: cgrun/cgrun.c:659
#, c-format
msgid "  --help       show this help and exit\n"
msgstr "  --help       näytä tämä ohje ja lopeta\n"

#: cgrun/cgrun.c:660
#, c-format
msgid "  --version    show the version and exit\n"
msgstr "  --version    näytä versio ja lopeta\n"

#: cgrun/cgrun.c:662
#, c-format
msgid "The usual GTK options, such as --display, are also understood.\n"
msgstr "Myös tavalliset GTK-valitsimet, kuten --display, ymmärretään.\n"
