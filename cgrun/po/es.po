#: cgrun/cgrun.c:499
msgid "Programs"
msgstr "Programas"

#: cgrun/cgrun.c:578 cgrun/cgrun.c:631
msgid "Run"
msgstr "Ejecutar"

#: cgrun/cgrun.c:590
msgid "Type the name of a program, or a command line."
msgstr "Escriba el nombre de un programa o una línea de órdenes."

#: cgrun/cgrun.c:598
msgid "Command:"
msgstr "Orden:"

#: cgrun/cgrun.c:617
msgid "Run in a terminal"
msgstr "Ejecutar en una terminal"

#: cgrun/cgrun.c:632
msgid "Close"
msgstr "Cerrar"

#: cgrun/cgrun.c:656
#, c-format
msgid "Usage: %s [OPTION...]\n"
msgstr "Uso: %s [OPCIÓN...]\n"

#: cgrun/cgrun.c:658
#, c-format
msgid "  --list       show the list of programs from the start\n"
msgstr "  --list       mostrar la lista de programas desde el principio\n"

#: cgrun/cgrun.c:659
#, c-format
msgid "  --help       show this help and exit\n"
msgstr "  --help       muestra esta ayuda y termina\n"

#: cgrun/cgrun.c:660
#, c-format
msgid "  --version    show the version and exit\n"
msgstr "  --version    muestra la versión y termina\n"

#: cgrun/cgrun.c:662
#, c-format
msgid "The usual GTK options, such as --display, are also understood.\n"
msgstr "También se entienden las opciones habituales de GTK, como --display.\n"
