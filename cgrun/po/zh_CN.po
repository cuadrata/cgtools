#: cgrun/cgrun.c:499
msgid "Programs"
msgstr "程序"

#: cgrun/cgrun.c:578 cgrun/cgrun.c:631
msgid "Run"
msgstr "运行"

#: cgrun/cgrun.c:590
msgid "Type the name of a program, or a command line."
msgstr "请输入程序名称或命令行。"

#: cgrun/cgrun.c:598
msgid "Command:"
msgstr "命令:"

#: cgrun/cgrun.c:617
msgid "Run in a terminal"
msgstr "在终端中运行"

#: cgrun/cgrun.c:632
msgid "Close"
msgstr "关闭"

#: cgrun/cgrun.c:656
#, c-format
msgid "Usage: %s [OPTION...]\n"
msgstr "用法：%s [选项...]\n"

#: cgrun/cgrun.c:658
#, c-format
msgid "  --list       show the list of programs from the start\n"
msgstr "  --list       从一开始就显示程序列表\n"

#: cgrun/cgrun.c:659
#, c-format
msgid "  --help       show this help and exit\n"
msgstr "  --help       显示此帮助并退出\n"

#: cgrun/cgrun.c:660
#, c-format
msgid "  --version    show the version and exit\n"
msgstr "  --version    显示版本并退出\n"

#: cgrun/cgrun.c:662
#, c-format
msgid "The usual GTK options, such as --display, are also understood.\n"
msgstr "也可使用 GTK 的常用选项，例如 --display。\n"
