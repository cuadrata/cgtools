#: cgrun/cgrun.c:499
msgid "Programs"
msgstr "Programok"

#: cgrun/cgrun.c:578 cgrun/cgrun.c:631
msgid "Run"
msgstr "Futtatás"

#: cgrun/cgrun.c:590
msgid "Type the name of a program, or a command line."
msgstr "Írja be egy program nevét vagy egy parancssort."

#: cgrun/cgrun.c:598
msgid "Command:"
msgstr "Parancs:"

#: cgrun/cgrun.c:617
msgid "Run in a terminal"
msgstr "Futtatás terminálban"

#: cgrun/cgrun.c:632
msgid "Close"
msgstr "Bezárás"

#: cgrun/cgrun.c:656
#, c-format
msgid "Usage: %s [OPTION...]\n"
msgstr "Használat: %s [KAPCSOLÓ...]\n"

#: cgrun/cgrun.c:658
#, c-format
msgid "  --list       show the list of programs from the start\n"
msgstr "  --list       a programok listájának megjelenítése indításkor\n"

#: cgrun/cgrun.c:659
#, c-format
msgid "  --help       show this help and exit\n"
msgstr "  --help       kiírja ezt a súgót és kilép\n"

#: cgrun/cgrun.c:660
#, c-format
msgid "  --version    show the version and exit\n"
msgstr "  --version    kiírja a verziót és kilép\n"

#: cgrun/cgrun.c:662
#, c-format
msgid "The usual GTK options, such as --display, are also understood.\n"
msgstr "A szokásos GTK-kapcsolókat, például a --display-t, is elfogadja.\n"
