#: cgrun/cgrun.c:499
msgid "Programs"
msgstr "Programmer"

#: cgrun/cgrun.c:578 cgrun/cgrun.c:631
msgid "Run"
msgstr "Kjør"

#: cgrun/cgrun.c:590
msgid "Type the name of a program, or a command line."
msgstr "Skriv inn navnet på et program eller en kommandolinje."

#: cgrun/cgrun.c:598
msgid "Command:"
msgstr "Kommando:"

#: cgrun/cgrun.c:617
msgid "Run in a terminal"
msgstr "Kjør i en terminal"

#: cgrun/cgrun.c:632
msgid "Close"
msgstr "Lukk"

#: cgrun/cgrun.c:656
#, c-format
msgid "Usage: %s [OPTION...]\n"
msgstr "Bruk: %s [VALG...]\n"

#: cgrun/cgrun.c:658
#, c-format
msgid "  --list       show the list of programs from the start\n"
msgstr "  --list       vis listen over programmer fra starten\n"

#: cgrun/cgrun.c:659
#, c-format
msgid "  --help       show this help and exit\n"
msgstr "  --help       vis denne hjelpen og avslutt\n"

#: cgrun/cgrun.c:660
#, c-format
msgid "  --version    show the version and exit\n"
msgstr "  --version    vis versjonen og avslutt\n"

#: cgrun/cgrun.c:662
#, c-format
msgid "The usual GTK options, such as --display, are also understood.\n"
msgstr "De vanlige GTK-valgene, som --display, forstås også.\n"
