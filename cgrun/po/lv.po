#: cgrun/cgrun.c:499
msgid "Programs"
msgstr "Programmas"

#: cgrun/cgrun.c:578 cgrun/cgrun.c:631
msgid "Run"
msgstr "Palaist"

#: cgrun/cgrun.c:590
msgid "Type the name of a program, or a command line."
msgstr "Ievadiet programmas nosaukumu vai komandrindu."

#: cgrun/cgrun.c:598
msgid "Command:"
msgstr "Komanda:"

#: cgrun/cgrun.c:617
msgid "Run in a terminal"
msgstr "Palaist terminālī"

#: cgrun/cgrun.c:632
msgid "Close"
msgstr "Aizvērt"

#: cgrun/cgrun.c:656
#, c-format
msgid "Usage: %s [OPTION...]\n"
msgstr "Lietošana: %s [OPCIJA...]\n"

#: cgrun/cgrun.c:658
#, c-format
msgid "  --list       show the list of programs from the start\n"
msgstr "  --list       uzreiz rādīt programmu sarakstu\n"

#: cgrun/cgrun.c:659
#, c-format
msgid "  --help       show this help and exit\n"
msgstr "  --help       parādīt šo palīdzību un iziet\n"

#: cgrun/cgrun.c:660
#, c-format
msgid "  --version    show the version and exit\n"
msgstr "  --version    parādīt versiju un iziet\n"

#: cgrun/cgrun.c:662
#, c-format
msgid "The usual GTK options, such as --display, are also understood.\n"
msgstr "Tiek saprastas arī parastās GTK opcijas, piemēram, --display.\n"
