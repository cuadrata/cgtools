#: cgrun/cgrun.c:499
msgid "Programs"
msgstr "Programes"

#: cgrun/cgrun.c:578 cgrun/cgrun.c:631
msgid "Run"
msgstr "Enonder"

#: cgrun/cgrun.c:590
msgid "Type the name of a program, or a command line."
msgstr "Tapez l' no d' on programe oudonbén ene roye di comande."

#: cgrun/cgrun.c:598
msgid "Command:"
msgstr "Comande:"

#: cgrun/cgrun.c:617
msgid "Run in a terminal"
msgstr "Enonder dins on terminå"

#: cgrun/cgrun.c:632
msgid "Close"
msgstr "Clôre"

#: cgrun/cgrun.c:656
#, c-format
msgid "Usage: %s [OPTION...]\n"
msgstr "Eployaedje: %s [TCHUZE...]\n"

#: cgrun/cgrun.c:658
#, c-format
msgid "  --list       show the list of programs from the start\n"
msgstr "  --list       mostrer l' djivêye des programes do côp\n"

#: cgrun/cgrun.c:659
#, c-format
msgid "  --help       show this help and exit\n"
msgstr "  --help       mostrer cist aidance ci et moussî foû\n"

#: cgrun/cgrun.c:660
#, c-format
msgid "  --version    show the version and exit\n"
msgstr "  --version    mostrer l' modêye et moussî foû\n"

#: cgrun/cgrun.c:662
#, c-format
msgid "The usual GTK options, such as --display, are also understood.\n"
msgstr ""
"Les tchuzes GTK d' acoutumance, come --display, sont eto comprinduwes.\n"
