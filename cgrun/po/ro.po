#: cgrun/cgrun.c:499
msgid "Programs"
msgstr "Programe"

#: cgrun/cgrun.c:578 cgrun/cgrun.c:631
msgid "Run"
msgstr "Rulează"

#: cgrun/cgrun.c:590
msgid "Type the name of a program, or a command line."
msgstr "Tastați numele unui program sau o linie de comandă."

#: cgrun/cgrun.c:598
msgid "Command:"
msgstr "Comandă:"

#: cgrun/cgrun.c:617
msgid "Run in a terminal"
msgstr "Rulează într-un terminal"

#: cgrun/cgrun.c:632
msgid "Close"
msgstr "Închide"

#: cgrun/cgrun.c:656
#, c-format
msgid "Usage: %s [OPTION...]\n"
msgstr "Utilizare: %s [OPȚIUNE...]\n"

#: cgrun/cgrun.c:658
#, c-format
msgid "  --list       show the list of programs from the start\n"
msgstr "  --list       arată lista de programe de la început\n"

#: cgrun/cgrun.c:659
#, c-format
msgid "  --help       show this help and exit\n"
msgstr "  --help       afișează acest ajutor și iese\n"

#: cgrun/cgrun.c:660
#, c-format
msgid "  --version    show the version and exit\n"
msgstr "  --version    afișează versiunea și iese\n"

#: cgrun/cgrun.c:662
#, c-format
msgid "The usual GTK options, such as --display, are also understood.\n"
msgstr "Sunt înțelese și opțiunile obișnuite GTK, precum --display.\n"
