#: cgrun/cgrun.c:499
msgid "Programs"
msgstr "நிரல்கள்"

#: cgrun/cgrun.c:578 cgrun/cgrun.c:631
msgid "Run"
msgstr "இயக்கு"

#: cgrun/cgrun.c:590
msgid "Type the name of a program, or a command line."
msgstr "ஒரு நிரலின் பெயரை அல்லது கட்டளை வரியை உள்ளிடவும்."

#: cgrun/cgrun.c:598
msgid "Command:"
msgstr "கட்டளை:"

#: cgrun/cgrun.c:617
msgid "Run in a terminal"
msgstr "முனையத்தில் இயக்கு"

#: cgrun/cgrun.c:632
msgid "Close"
msgstr "மூடு"

#: cgrun/cgrun.c:656
#, c-format
msgid "Usage: %s [OPTION...]\n"
msgstr "பயன்பாடு: %s [விருப்பம்...]\n"

#: cgrun/cgrun.c:658
#, c-format
msgid "  --list       show the list of programs from the start\n"
msgstr "  --list       தொடக்கத்திலிருந்தே நிரல்களின் பட்டியலைக் காட்டு\n"

#: cgrun/cgrun.c:659
#, c-format
msgid "  --help       show this help and exit\n"
msgstr "  --help       இந்த உதவியைக் காட்டி வெளியேறு\n"

#: cgrun/cgrun.c:660
#, c-format
msgid "  --version    show the version and exit\n"
msgstr "  --version    பதிப்பைக் காட்டி வெளியேறு\n"

#: cgrun/cgrun.c:662
#, c-format
msgid "The usual GTK options, such as --display, are also understood.\n"
msgstr "--display போன்ற வழக்கமான GTK விருப்பங்களும் புரிந்துகொள்ளப்படும்.\n"
