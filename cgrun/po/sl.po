#: cgrun/cgrun.c:499
msgid "Programs"
msgstr "Programi"

#: cgrun/cgrun.c:578 cgrun/cgrun.c:631
msgid "Run"
msgstr "Zaženi"

#: cgrun/cgrun.c:590
msgid "Type the name of a program, or a command line."
msgstr "Vpišite ime programa ali ukazno vrstico."

#: cgrun/cgrun.c:598
msgid "Command:"
msgstr "Ukaz:"

#: cgrun/cgrun.c:617
msgid "Run in a terminal"
msgstr "Zaženi v terminalu"

#: cgrun/cgrun.c:632
msgid "Close"
msgstr "Zapri"

#: cgrun/cgrun.c:656
#, c-format
msgid "Usage: %s [OPTION...]\n"
msgstr "Uporaba: %s [MOŽNOST...]\n"

#: cgrun/cgrun.c:658
#, c-format
msgid "  --list       show the list of programs from the start\n"
msgstr "  --list       pokaži seznam programov že na začetku\n"

#: cgrun/cgrun.c:659
#, c-format
msgid "  --help       show this help and exit\n"
msgstr "  --help       izpiše to pomoč in konča\n"

#: cgrun/cgrun.c:660
#, c-format
msgid "  --version    show the version and exit\n"
msgstr "  --version    izpiše različico in konča\n"

#: cgrun/cgrun.c:662
#, c-format
msgid "The usual GTK options, such as --display, are also understood.\n"
msgstr "Razumljene so tudi običajne možnosti GTK, kot je --display.\n"
